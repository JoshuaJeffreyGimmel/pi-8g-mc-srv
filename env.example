# --- Required ---

# RCON password. Only reachable from inside the container (port 25575 is not
# published), but set something real anyway.
RCON_PASSWORD=changeme

# Modrinth modpack source. One of:
#   - Public listing URL:        https://modrinth.com/modpack/your-pack-slug
#   - Pinned version (safer):    https://modrinth.com/modpack/your-pack-slug/version/1.0.0
#   - Local file for testing:    /data/modpacks/yourpack.mrpack
#     (must be placed under ./data/modpacks/ on the host first; file:// URLs
#     do not work, it must be a plain container path ending in .mrpack)
MODRINTH_MODPACK=https://modrinth.com/modpack/your-pack-slug

# --- Access ---

# Operators, comma-separated. Set this before first boot — the server is
# whitelisted, so without it nobody can join and nobody has admin rights.
MC_OPS=YourMinecraftName

# Initial whitelist, comma-separated. Players added later with
# `./mc whitelist <name>` are merged in and survive restarts.
MC_WHITELIST=YourMinecraftName

# Address to publish the game port on. Leave unset (0.0.0.0) and the server is
# reachable from your whole LAN. Set it to the Pi's Tailscale IP
# (`tailscale ip -4`) to restrict it to your tailnet.
#MC_BIND_ADDR=100.101.102.103

# --- Optional overrides ---

# Server type. MODRINTH installs the pack directly; only change this if you
# ever move away from the modpack (e.g. back to plain PAPER or NEOFORGE).
MC_TYPE=MODRINTH

# Loader the modpack was built for.
MODRINTH_LOADER=fabric

# Minecraft version. Pin explicitly — never leave this on LATEST, or a restart
# can silently upgrade the server and break plugins/mods.
MC_VERSION=1.21.1

# Java heap. See the note in docker-compose.yml before raising this.
MC_MEMORY=4G

# Hard container memory ceiling. Keep this above MC_MEMORY plus ~25%, or the
# JVM gets OOM-killed during normal operation.
MC_MEMORY_LIMIT=6G

# Set FALSE only if your pack has no flight-granting items and you want the
# vanilla anti-cheat back.
MC_ALLOW_FLIGHT=TRUE

# Must match the host user owning ./data. Check with `id -u` / `id -g`.
MC_UID=1000
MC_GID=1000

TZ=Europe/Zurich
